# App settings
PROJECT_NAME="Tech News Hub"
ENVIRONMENT=development
DEBUG=true

# Host Port Mappings (avoid collisions with existing local containers)
FRONTEND_PORT=3001
BACKEND_PORT=8001
POSTGRES_PORT=5433

# PostgreSQL Database settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=technewshub
POSTGRES_HOST=postgres
POSTGRES_INTERNAL_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/technewshub

# CORS settings (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]

# Worker & Provider settings
WORKER_INTERVAL_SECONDS=300
HN_MAX_STORIES=30
HTTP_REQUEST_TIMEOUT=15

# Frontend settings (client-side reachable URL)
NEXT_PUBLIC_API_URL=http://localhost:8001

# Translation Settings
TRANSLATION_ENABLED=true
# Providers: mymemory (free, no key needed), deepl (requires TRANSLATION_API_KEY), libretranslate, mock, auto
TRANSLATION_PROVIDER=mymemory
TRANSLATION_API_KEY=
TRANSLATION_TARGET_LANGUAGE=pt-BR
TRANSLATION_TIMEOUT_SECONDS=10
# TRANSLATION_DEEPL_API_URL=https://api-free.deepl.com/v2/translate
# TRANSLATION_LIBRETRANSLATE_API_URL=http://localhost:5000/translate
